# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.

# Database
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/calendar_db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=3d
PORT=3001

# Chinabidding scraper credentials
# Consumed by docker-compose (variable substitution) and by the backend at runtime.
CHINABIDDING_BASE_URL=https://www.chinabidding.com/en
CHINABIDDING_CAS_LOGIN_URL=https://cas.ebnew.com/cas/login
CHINABIDDING_USERNAME=your-chinabidding-username
CHINABIDDING_PASSWORD=your-chinabidding-password

# DeepSeek API — used by backend/src/services/deepseek.js for relevance filtering
# and structured extraction of tender notices. Without it, analysis is skipped.
DEEPSEEK_API_KEY=your-deepseek-api-key

# SMTP (company mailbox) — bid-watch email notifications (services/mailer.js).
# Leave unset to disable email; in-app notifications still work.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Herkules CRM <noreply@example.com>"

# Google Gemini — vision OCR for bid-opening photos and visit-report captions
# (backend/src/services/gemini.js). Free key from https://aistudio.google.com/apikey.
# Without it, image upload is disabled. Visit-report captions stay blank and can be typed.
GEMINI_API_KEY=your-gemini-api-key

# Visit-report photos. Optional. When unset, files go to backend/data/visit-reports
# (gitignored, created on demand, removed with the report). Set this only to move
# the directory off the checkout. No database migration.
# VISIT_REPORT_STORAGE_DIR=

# GMT field service on the customer page (read-only).
# GET {GMT_API_BASE}/api/internal/herkules/customers/:id/field-service
# Header: X-GMT-Token: <GMT_CUSTOMER_SYNC_TOKEN>
# GMT_CUSTOMER_SYNC_TOKEN is the existing shared secret. GMT stores the same
# value as HERKULES_GMT_TOKEN and already sends it as X-GMT-Token when it
# pulls customers. Do not add a second token. There is no Authorization bearer.
# Leave the token unset and the customer page shows a quiet "not connected" note.
# GMT_API_BASE defaults to https://gmt.herkulesgroup-china.com when unset.
GMT_API_BASE=https://gmt.herkulesgroup-china.com
GMT_CUSTOMER_SYNC_TOKEN=
